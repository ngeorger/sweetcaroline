# Copy to `.env` (gitignored) and adjust. Every value is read at build/import
# time from the process environment; there is nothing to configure at runtime.
#
#   cp .env.example .env
#
# Shell-set variables win over this file, so a one-off run can override any of
# them inline:  SITE_URL=... npm run build

# ---------------------------------------------------------------------------
# Contenido — origen del WordPress
# ---------------------------------------------------------------------------
# Origin of the WordPress REST API that seeds src/content/**.
# REQUIRED by `npm run content:import` / `npm run content:check`. There is no
# default on purpose: a misconfigured run must fail before it reaches the network
# rather than quietly read production.
WORDPRESS_BASE_URL=https://old.sweetcaroline.cl

# ---------------------------------------------------------------------------
# Sitio — dónde se publica este build
# ---------------------------------------------------------------------------
# Public URL of the deployed site. `astro.config.mjs` derives `base` from this
# value's path, so a project-page deploy cannot emit root-absolute URLs that 404.
# Defaults to https://sweetcaroline.cl (apex, `base: '/'`) when unset.
# SITE_URL=https://sredevopsorgagents.github.io/sweetcaroline

# Escape hatch: overrides the derived base. Normally leave it unset.
# BASE_PATH=/sweetcaroline

# ---------------------------------------------------------------------------
# Indexación
# ---------------------------------------------------------------------------
# While the preview must stay unlisted this stays unset, which emits
# `noindex, nofollow` on every page and publishes no sitemap. Set to 1 only
# when the site is meant to be found.
# ALLOW_INDEXING=1
