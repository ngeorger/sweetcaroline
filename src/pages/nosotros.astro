---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { requireImage } from '../lib/images';

const entry = await getEntry('pages', 'nosotros');
if (!entry) throw new Error('Content entry "nosotros" is missing. Run: npm run content:import');

const { Content } = await render(entry);
const images = entry.data.images.map((image) => ({ ...image, src: requireImage(image.key) }));

const trail = [
  { name: 'Inicio', path: '/' },
  { name: 'Nosotros', path: '/nosotros/' },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={images[0]?.src}
  imageAlt={images[0]?.alt}
  breadcrumbs={trail}
>
  <PageHeader
    eyebrow="La pastelería"
    title={entry.data.title}
    description="Un taller de pastelería fina en San Joaquín, Santiago."
    trail={trail}
  />

  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="prose-brand max-w-3xl">
      <Content />
    </div>

    {
      images.length > 0 && (
        <ul class="mt-12 grid gap-4 sm:grid-cols-3">
          {images.map((image) => (
            <li>
              <Image
                src={image.src}
                alt={image.alt}
                widths={[280, 480, 720]}
                sizes="(min-width: 640px) 30vw, 92vw"
                loading="lazy"
                class="w-full rounded-2xl"
              />
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <ContactStrip />
</BaseLayout>

<style>
  /* Rendered Markdown. Scoped here rather than pulling in a typography plugin
     for the three prose elements this site actually has. */
  .prose-brand :global(h2) {
    color: var(--color-brand-900);
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .prose-brand :global(h2:first-child) {
    margin-top: 0;
  }

  .prose-brand :global(p) {
    color: var(--color-ink-700);
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .prose-brand :global(a) {
    color: var(--color-brand-700);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
